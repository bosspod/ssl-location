APP_ENV=development
APP_PORT=8010
DATABASE_URL=mongodb://location:location@mongo:27017/?authSource=admin
MONGODB_DATABASE=ssl_location_optimization
GOOGLE_MAPS_API_KEY=
# Recommended for the iframe: use a separate Maps Embed API key restricted by HTTP referrer.
# Development falls back to GOOGLE_MAPS_API_KEY when this is left empty.
GOOGLE_MAPS_EMBED_API_KEY=
HERE_API_KEY=
LONGDO_API_KEY=
OPENAI_API_KEY=
DBD_API_ENABLED=true
DBD_API_BASE_URL=https://openapi.dbd.go.th/api/v1
DBD_NAME_API_BASE_URL=https://api.egov.go.th
DBD_CONSUMER_KEY=
DBD_CONSUMER_SECRET=
DBD_AGENT_ID=
REGISTRY_REQUEST_TIMEOUT_SECONDS=10
GOOGLE_PLACE_DETAILS_LIMIT=10
AI_RESEARCH_ENABLED=true
AI_RESEARCH_MODEL=gpt-5.6-luna
AI_RESEARCH_TIMEOUT_SECONDS=300
AI_RESEARCH_MAX_QUERIES=12
AI_RESEARCH_MAX_TOOL_CALLS=8
AI_RESEARCH_MAX_ROUNDS=3
INITIAL_SEARCH_QUERIES=8
ADDITIONAL_SEARCH_QUERIES=5
AI_CANDIDATE_LIMIT=15
AI_ACCEPT_CONFIDENCE=0.50
AI_RESEARCH_CACHE_TTL_SECONDS=86400
OSM_NOMINATIM_BASE_URL=
OSM_USER_AGENT=
GOOGLE_REQUEST_TIMEOUT_SECONDS=4
GOOGLE_MAX_RETRIES=1
GOOGLE_MAX_PAGES=2
PROVIDER_RESULT_LIMIT=20
PROVIDER_CONCURRENCY=8
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
PROVIDER_CIRCUIT_COOLDOWN_SECONDS=30
LONGDO_RATE_LIMIT_PER_MINUTE=60
OSM_RATE_LIMIT_PER_SECOND=1
OSM_MAX_SEARCH_QUERIES=1
REQUIRE_ALL_PROVIDERS_IN_PRODUCTION=true
MAX_SEARCH_QUERIES=40
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=5000
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_CLIENTS=10000
SIGNING_SECRET=change-me-in-production
LOG_LEVEL=INFO
